<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#6D35E8</item>

        <!-- Keep the Android status bar visible and readable after the splash. -->
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@drawable/splash_screen</item>

        <!-- Android 12+ splash configuration remains dark and uses the Spark 06 icon. -->
        <item name="android:windowSplashScreenBackground">@color/indoone_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/indoone_android12_splash_icon</item>
    </style>
</resources>
