<?xml version="1.0" encoding="utf-8"?>
<!--
  The Vibe session notification draws its own row so the close button is always
  visible and sits on the right. A stock notification hides its single action
  behind the expand arrow on some Android builds.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/vibe_notification_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:scaleType="fitCenter"
        android:contentDescription="Indoone AI" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/vibe_notification_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF2C2733"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vibe_notification_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FF6F6A7A"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/vibe_notification_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_indoone_close"
        android:contentDescription="End the Vibe session"
        android:tint="#FFD32F2F" />
</LinearLayout>
